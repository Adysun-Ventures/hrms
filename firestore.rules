rules_version = '2';

// Identity comes from the Firebase custom token minted by /api/auth/login:
//   request.auth.token.role       'admin' | 'employee'
//   request.auth.token.employeeId the employee's doc id (employees only)
// Anything the browser needs about *other* people goes through /api/lookup or /api/emp-details.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function me() { return request.auth.token.employeeId; }
    function isEmployee() { return signedIn() && request.auth.token.role == 'employee' && me() != null; }
    function ownsDoc() { return isEmployee() && resource.data.employeeId == me(); }
    function keepsOwner() { return request.resource.data.employeeId == resource.data.employeeId; }

    // Password hashes: server (Admin SDK) only.
    match /credentials/{uid} {
      allow read, write: if false;
    }

    match /employees/{id} {
      allow read, write: if isAdmin();
      allow get: if isEmployee() && id == me();
      // Self profile edit; status/resignation/identity/login fields (phone = login ID) stay admin-only.
      allow update: if isEmployee() && id == me()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
             ['status', 'is_resigned', 'employmentStatus', 'resignedDate', 'lastWorkingDay', 'employeeId', 'password', 'phone']);
    }

    // Employment: read own; self-edit can't move it or change status.
    match /employments/{id} {
      allow read, write: if isAdmin();
      allow read: if ownsDoc();
      allow update: if ownsDoc() && keepsOwner()
        && request.resource.data.get('employeeStatus', null) == resource.data.get('employeeStatus', null);
    }

    // Employees can add/edit their own salary entries (My Salary → Add / Edit).
    match /salaries/{id} {
      allow read, write: if isAdmin();
      allow read: if ownsDoc();
      allow create: if isEmployee() && request.resource.data.employeeId == me();
      allow update: if ownsDoc() && keepsOwner();
    }

    match /login_logs/{id} {
      allow read, write: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /admins/{id} { allow read, write: if isAdmin(); }
    match /admin_sessions/{id} { allow read, write: if isAdmin(); }
    match /counters/{id} { allow read, write: if isAdmin(); }

    // Everything else: admins only.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
